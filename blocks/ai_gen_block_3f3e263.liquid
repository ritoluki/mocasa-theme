{% doc %}
  @prompt
    Tạo 1 hộp text để khách hàng viết đánh giá
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-review-form__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-review-form__description-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.spacing }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-review-form__form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-review-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-review-form__label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-weight: 500;
    font-size: 14px;
  }

  .ai-review-form__required-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  .ai-review-form__input-{{ ai_gen_id }},
  .ai-review-form__textarea-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
    font-family: inherit;
    width: 100%;
  }

  .ai-review-form__input-{{ ai_gen_id }}:focus,
  .ai-review-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  .ai-review-form__textarea-{{ ai_gen_id }} {
    min-height: {{ block.settings.textarea_height }}px;
    resize: vertical;
  }

  .ai-review-form__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .ai-review-form__star-input-{{ ai_gen_id }} {
    display: none;
  }

  .ai-review-form__star-label-{{ ai_gen_id }} {
    cursor: pointer;
    font-size: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_empty_color }};
    transition: color 0.2s ease;
  }

  .ai-review-form__star-input-{{ ai_gen_id }}:checked ~ .ai-review-form__star-label-{{ ai_gen_id }},
  .ai-review-form__star-label-{{ ai_gen_id }}:hover,
  .ai-review-form__star-label-{{ ai_gen_id }}:hover ~ .ai-review-form__star-label-{{ ai_gen_id }} {
    color: {{ block.settings.star_filled_color }};
  }

  .ai-review-form__button-{{ ai_gen_id }} {
    padding: 14px 28px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s ease;
    align-self: flex-start;
  }

  .ai-review-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-review-form__success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.success_background }};
    color: {{ block.settings.success_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: {{ block.settings.spacing }}px;
  }

  .ai-review-form__error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.error_background }};
    color: {{ block.settings.error_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: {{ block.settings.spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-review-form-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<review-form-{{ ai_gen_id }} class="ai-review-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-review-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-review-form__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
  {% endif %}

  {%- form 'contact' -%}
    <input type="hidden" name="contact[review_product_id]" value="{{ product.id }}">
    <input type="hidden" name="contact[review_product_title]" value="{{ product.title }}">
    
    <div class="ai-review-form__form-{{ ai_gen_id }}">
      {% if block.settings.show_rating %}
        <div class="ai-review-form__field-{{ ai_gen_id }}">
          <label class="ai-review-form__label-{{ ai_gen_id }}">
            {{ block.settings.rating_label }}
            <span class="ai-review-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <div class="ai-review-form__rating-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% assign star_value = 6 | minus: i %}
              <input
                type="radio"
                name="contact[rating]"
                id="ai-review-star-{{ ai_gen_id }}-{{ star_value }}"
                value="{{ star_value }}"
                class="ai-review-form__star-input-{{ ai_gen_id }}"
                required
                {% if star_value == 5 %}checked{% endif %}
              >
              <label
                for="ai-review-star-{{ ai_gen_id }}-{{ star_value }}"
                class="ai-review-form__star-label-{{ ai_gen_id }}"
                aria-label="{{ star_value }} stars"
              >★</label>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_name %}
        <div class="ai-review-form__field-{{ ai_gen_id }}">
          <label for="ai-review-name-{{ ai_gen_id }}" class="ai-review-form__label-{{ ai_gen_id }}">
            {{ block.settings.name_label }}
            <span class="ai-review-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="ai-review-name-{{ ai_gen_id }}"
            name="contact[name]"
            class="ai-review-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.name_placeholder }}"
            required
            autocomplete="name"
          >
        </div>
      {% endif %}

      {% if block.settings.show_email %}
        <div class="ai-review-form__field-{{ ai_gen_id }}">
          <label for="ai-review-email-{{ ai_gen_id }}" class="ai-review-form__label-{{ ai_gen_id }}">
            {{ block.settings.email_label }}
            <span class="ai-review-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="email"
            id="ai-review-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-review-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            required
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-review-form-error-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>
      {% endif %}

      <div class="ai-review-form__field-{{ ai_gen_id }}">
        <label for="ai-review-title-{{ ai_gen_id }}" class="ai-review-form__label-{{ ai_gen_id }}">
          {{ block.settings.review_title_label }}
          <span class="ai-review-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="ai-review-title-{{ ai_gen_id }}"
          name="contact[review_title]"
          class="ai-review-form__input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.review_title_placeholder }}"
          required
        >
      </div>

      <div class="ai-review-form__field-{{ ai_gen_id }}">
        <label for="ai-review-body-{{ ai_gen_id }}" class="ai-review-form__label-{{ ai_gen_id }}">
          {{ block.settings.review_body_label }}
          <span class="ai-review-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <textarea
          id="ai-review-body-{{ ai_gen_id }}"
          name="contact[body]"
          class="ai-review-form__textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.review_body_placeholder }}"
          required
        ></textarea>
      </div>

      <button type="submit" class="ai-review-form__button-{{ ai_gen_id }}">
        {{ block.settings.submit_button_text }}
      </button>

      {%- if form.posted_successfully? -%}
        <div class="ai-review-form__success-{{ ai_gen_id }}">
          {{ block.settings.success_message }}
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div id="ai-review-form-error-{{ ai_gen_id }}" class="ai-review-form__error-{{ ai_gen_id }}">
          {{ form.errors.messages | first }}
        </div>
      {%- endif -%}
    </div>
  {%- endform -%}
</review-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.stars = this.querySelectorAll('.ai-review-form__star-label-{{ ai_gen_id }}');
        this.setupStarRating();
      }

      setupStarRating() {
        this.stars.forEach((star) => {
          star.addEventListener('click', () => {
            const input = this.querySelector(`#${star.getAttribute('for')}`);
            if (input) {
              input.checked = true;
            }
          });
        });
      }
    }

    customElements.define('review-form-{{ ai_gen_id }}', ReviewForm{{ ai_gen_id }});
  })();
</script>

