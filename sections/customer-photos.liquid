{% comment %}
  Section: Customer Photos (UGC Grid)
  Cách dùng: đặt file này vào thư mục /sections/ của theme,
  sau đó vào Online Store > Customize > Add section > Customer Photos
{% endcomment %}

<div class="customer-photos-section" style="padding: 40px 20px; max-width: 1400px; margin: 0 auto;">
  {% if section.settings.heading != blank %}
    <h2 class="customer-photos-heading" style="font-size: 28px; font-weight: 800; margin: 0 0 30px;">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="customer-photos-grid"
       style="display: grid;
              grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
              gap: 16px;">
    {% for block in section.blocks %}
      {% if block.type == "photo" %}
        {% assign photo_link = block.settings.link %}
        <div class="customer-photo-item" {{ block.shopify_attributes }}>
          {% if photo_link != blank %}
            <a href="{{ photo_link }}" style="display: block;">
          {% endif %}
              <div style="width: 100%; aspect-ratio: 1/1; overflow: hidden; border-radius: 6px; background: #f2f2f2;">
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 700 }}"
                       alt="{{ block.settings.alt | default: 'Customer photo' | escape }}"
                       loading="lazy"
                       style="width: 100%; height: 100%; object-fit: cover; display: block;">
                {% endif %}
              </div>
          {% if photo_link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  @media (max-width: 749px) {
    .customer-photos-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
      gap: 8px !important;
    }
    .customer-photos-heading {
      font-size: 22px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Customer Photos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let Customers Speak For Us"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text (for SEO/accessibility)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional — e.g. the product shown in this photo)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Photos",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
