    "custom_liquid_g4Xx6U": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n@media (min-width: 750px) {\n  /* Desktop navigation: reveal dropdowns while the parent item is hovered or focused. */\n  .menu-list__list-item:hover > .menu-list__submenu,\n  .menu-list__list-item:focus-within > .menu-list__submenu,\n  nav li:hover > ul,\n  nav li:focus-within > ul {\n    display: block;\n    visibility: visible;\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .menu-list__list-item:hover > .menu-list__link,\n  .menu-list__list-item:focus-within > .menu-list__link,\n  nav li:hover > a,\n  nav li:focus-within > a {\n    position: relative;\n    z-index: 2;\n  }\n}\n</style>\n<script>\n(function () {\n  function enableHoverMenus() {\n    if (window.matchMedia('(max-width: 749px)').matches) return;\n\n    var items = document.querySelectorAll('header nav li, .menu-list__list-item');\n    items.forEach(function (item) {\n      var submenu = item.querySelector(':scope > .menu-list__submenu, :scope > ul');\n      if (!submenu || item.dataset.hoverMenuReady === 'true') return;\n      item.dataset.hoverMenuReady = 'true';\n\n      var trigger = item.querySelector(':scope > a, :scope > button, :scope > summary');\n      var open = function () {\n        item.classList.add('is-open', 'open', 'active');\n        submenu.classList.add('is-open', 'open', 'active');\n        if (trigger) trigger.setAttribute('aria-expanded', 'true');\n      };\n      var close = function () {\n        if (item.matches(':focus-within')) return;\n        item.classList.remove('is-open', 'open', 'active');\n        submenu.classList.remove('is-open', 'open', 'active');\n        if (trigger) trigger.setAttribute('aria-expanded', 'false');\n      };\n      item.addEventListener('mouseenter', open);\n      item.addEventListener('mouseleave', close);\n    });\n  }\n\n  document.addEventListener('DOMContentLoaded', enableHoverMenus);\n  window.addEventListener('resize', enableHoverMenus);\n})();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
