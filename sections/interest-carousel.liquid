{% comment %}
  Section: Interest Carousel (with arrows)
  Cách dùng: đặt file này vào /sections/, sau đó
  Online Store > Customize > Add section > Interest Carousel
{% endcomment %}

<div class="interest-carousel-section" style="padding: 40px 20px; max-width: 1400px; margin: 0 auto; position: relative;">
  {% if section.settings.heading != blank %}
    <h2 style="font-size: 24px; font-weight: 800; margin: 0 0 24px;">{{ section.settings.heading }}</h2>
  {% endif %}

  <div style="position: relative;">
    <button type="button"
            class="interest-carousel-prev"
            aria-label="Previous"
            style="position: absolute; left: -8px; top: 50%; transform: translateY(-50%);
                   z-index: 2; width: 40px; height: 40px; border-radius: 50%;
                   border: none; background: rgba(255,255,255,0.9); box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                   cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;">
      &#8249;
    </button>

    <div class="interest-carousel-track"
         data-carousel-track
         style="display: flex;
                gap: 20px;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                scroll-behavior: smooth;
                -ms-overflow-style: none;
                scrollbar-width: none;
                padding-bottom: 4px;">
      {% for block in section.blocks %}
        {% if block.type == "card" %}
          <a href="{{ block.settings.link | default: '#' }}"
             {{ block.shopify_attributes }}
             style="flex: 0 0 {{ section.settings.card_width }}px;
                    scroll-snap-align: start;
                    text-decoration: none;
                    color: inherit;
                    display: block;">
            <div style="width: 100%; aspect-ratio: 1/1; border-radius: 10px; overflow: hidden; background: #eee;">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.label | escape }}"
                     loading="lazy"
                     style="width: 100%; height: 100%; object-fit: cover; display: block;">
              {% endif %}
            </div>
            <p style="margin-top: 12px; font-size: 15px; font-weight: 600;">{{ block.settings.label }}</p>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <button type="button"
            class="interest-carousel-next"
            aria-label="Next"
            style="position: absolute; right: -8px; top: 50%; transform: translateY(-50%);
                   z-index: 2; width: 40px; height: 40px; border-radius: 50%;
                   border: none; background: rgba(255,255,255,0.9); box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                   cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;">
      &#8250;
    </button>
  </div>
</div>

<style>
  .interest-carousel-track::-webkit-scrollbar { display: none; }
  @media (max-width: 749px) {
    .interest-carousel-section h2 { font-size: 20px !important; }
  }
</style>

<script>
  (function() {
    document.querySelectorAll('.interest-carousel-section').forEach(function(section) {
      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('.interest-carousel-prev');
      var nextBtn = section.querySelector('.interest-carousel-next');
      if (!track || !prevBtn || !nextBtn) return;

      function scrollAmount() {
        var card = track.querySelector('a');
        return card ? card.offsetWidth + 20 : 300;
      }

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -scrollAmount() * 2, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: scrollAmount() * 2, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Interest Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's your loved one into?"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (px)",
      "min": 180,
      "max": 400,
      "step": 10,
      "default": 280
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carousel card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Back To School"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (collection or page)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interest Carousel",
      "blocks": [
        { "type": "card", "settings": { "label": "Back To School" } },
        { "type": "card", "settings": { "label": "Father's Day" } },
        { "type": "card", "settings": { "label": "Sale" } },
        { "type": "card", "settings": { "label": "Graduation" } },
        { "type": "card", "settings": { "label": "Mother's Day" } },
        { "type": "card", "settings": { "label": "Christmas" } }
      ]
    }
  ]
}
{% endschema %}
