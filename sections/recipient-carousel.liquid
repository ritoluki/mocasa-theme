{% comment %}
  Section: Recipient Carousel (circle images with arrows)
  Cách dùng: đặt file này vào /sections/, sau đó
  Online Store > Customize > Add section > Recipient Carousel
{% endcomment %}

<div class="recipient-carousel-section" style="padding: 40px 20px; max-width: 1400px; margin: 0 auto; position: relative;">
  {% if section.settings.heading != blank %}
    <h2 style="font-size: 22px; font-weight: 800; margin: 0 0 24px;">{{ section.settings.heading }}</h2>
  {% endif %}

  <div style="position: relative;">
    <button type="button"
            class="recipient-carousel-prev"
            aria-label="Previous"
            style="position: absolute; left: -8px; top: {{ section.settings.circle_size }}px;
                   transform: translateY(-50%);
                   z-index: 2; width: 40px; height: 40px; border-radius: 50%;
                   border: none; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                   cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;">
      &#8249;
    </button>

    <div class="recipient-carousel-track"
         data-carousel-track
         style="display: flex;
                gap: 24px;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                scroll-behavior: smooth;
                -ms-overflow-style: none;
                scrollbar-width: none;
                padding-bottom: 4px;">
      {% for block in section.blocks %}
        {% if block.type == "circle" %}
          <a href="{{ block.settings.link | default: '#' }}"
             {{ block.shopify_attributes }}
             style="flex: 0 0 {{ section.settings.circle_size }}px;
                    scroll-snap-align: start;
                    text-decoration: none;
                    color: inherit;
                    text-align: center;
                    display: block;">
            <div style="width: {{ section.settings.circle_size }}px;
                        height: {{ section.settings.circle_size }}px;
                        border-radius: 50%;
                        overflow: hidden;
                        background: {{ block.settings.bg_color | default: section.settings.default_bg_color }};
                        display: flex;
                        align-items: flex-end;
                        justify-content: center;">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.label | escape }}"
                     loading="lazy"
                     style="width: 100%; height: 100%; object-fit: cover; display: block;">
              {% endif %}
            </div>
            <p style="margin-top: 14px; font-size: 15px; font-weight: 600;">{{ block.settings.label }}</p>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <button type="button"
            class="recipient-carousel-next"
            aria-label="Next"
            style="position: absolute; right: -8px; top: {{ section.settings.circle_size }}px;
                   transform: translateY(-50%);
                   z-index: 2; width: 40px; height: 40px; border-radius: 50%;
                   border: none; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                   cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center;">
      &#8250;
    </button>
  </div>
</div>

<style>
  .recipient-carousel-track::-webkit-scrollbar { display: none; }
  @media (max-width: 749px) {
    .recipient-carousel-section h2 { font-size: 19px !important; }
  }
</style>

<script>
  (function() {
    document.querySelectorAll('.recipient-carousel-section').forEach(function(section) {
      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('.recipient-carousel-prev');
      var nextBtn = section.querySelector('.recipient-carousel-next');
      if (!track || !prevBtn || !nextBtn) return;

      function scrollAmount() {
        var card = track.querySelector('a');
        return card ? card.offsetWidth + 24 : 260;
      }

      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -scrollAmount() * 2, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: scrollAmount() * 2, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Recipient Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Recipient"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size (px)",
      "min": 160,
      "max": 320,
      "step": 10,
      "default": 240
    },
    {
      "type": "color",
      "id": "default_bg_color",
      "label": "Default circle background color",
      "default": "#fbe4d8"
    }
  ],
  "blocks": [
    {
      "type": "circle",
      "name": "Recipient circle",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "For Mom"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (collection or page)"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Circle background color (optional override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipient Carousel",
      "blocks": [
        { "type": "circle", "settings": { "label": "For Mom" } },
        { "type": "circle", "settings": { "label": "For Grandma" } },
        { "type": "circle", "settings": { "label": "For Dad" } },
        { "type": "circle", "settings": { "label": "Pet Lovers" } },
        { "type": "circle", "settings": { "label": "For Family" } },
        { "type": "circle", "settings": { "label": "Star War Costumes" } }
      ]
    }
  ]
}
{% endschema %}
