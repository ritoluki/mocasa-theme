{% comment %}
  Section: Shop By Categories (square/rectangular grid)
  Cách dùng: đặt file này vào /sections/, sau đó
  Online Store > Customize > Add section > Shop By Categories
{% endcomment %}

<div class="shop-categories-section" style="padding: 40px 20px; max-width: 1400px; margin: 0 auto;">
  {% if section.settings.heading != blank %}
    <h2 style="font-size: 24px; font-weight: 800; margin: 0 0 24px;">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="shop-categories-grid"
       style="display: grid;
              grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
              gap: 20px;">
    {% for block in section.blocks %}
      {% if block.type == "category" %}
        <a href="{{ block.settings.link | default: '#' }}"
           {{ block.shopify_attributes }}
           style="text-decoration: none; color: inherit; display: block; text-align: center;">
          <div style="width: 100%; aspect-ratio: 1/1; border-radius: 8px; overflow: hidden; background: #eee;">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 700 }}"
                   alt="{{ block.settings.label | escape }}"
                   loading="lazy"
                   style="width: 100%; height: 100%; object-fit: cover; display: block;">
            {% endif %}
          </div>
          {% if block.settings.label != blank %}
            <p style="margin-top: 12px; font-size: 15px; font-weight: 600; text-align: center;">{{ block.settings.label }}</p>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  @media (max-width: 749px) {
    .shop-categories-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
      gap: 12px !important;
    }
    .shop-categories-section h2 { font-size: 20px !important; }
  }
</style>

{% schema %}
{
  "name": "Shop By Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Categories"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (collection or page)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
