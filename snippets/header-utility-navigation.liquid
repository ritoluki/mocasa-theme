{%- doc -%}
  Renders compact informational navigation in the desktop header.

  @param {object} menu - Shopify link list used for utility pages
{%- enddoc -%}

{% if menu != blank and menu.links.size > 0 %}
  <script
    src="{{ 'header-disclosure-navigation.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <header-disclosure-navigation class="header-utility-navigation" ref="headerMenu">
    <nav aria-label="Helpful links">
      <ul class="header-utility-navigation__list list-unstyled" role="list">
        {% for link in menu.links %}
          <li class="header-utility-navigation__item">
            {% if link.links == blank %}
              <a
                class="header-utility-navigation__link{% if link.active %} header-utility-navigation__link--active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            {% else %}
              <details class="header-utility-navigation__details">
                <summary class="header-utility-navigation__link">
                  <span>{{ link.title | escape }}</span>
                  <span class="svg-wrapper header-utility-navigation__caret" aria-hidden="true">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>

                <div class="header-utility-navigation__dropdown">
                  <ul class="header-utility-navigation__dropdown-list list-unstyled" role="list">
                    {% for child_link in link.links %}
                      <li>
                        <a
                          class="header-utility-navigation__dropdown-link"
                          href="{{ child_link.url }}"
                          {% if child_link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- child_link.title | escape -}}
                        </a>

                        {% if child_link.links != blank %}
                          <ul class="header-utility-navigation__nested-list list-unstyled" role="list">
                            {% for grandchild_link in child_link.links %}
                              <li>
                                <a class="header-utility-navigation__nested-link" href="{{ grandchild_link.url }}">
                                  {{- grandchild_link.title | escape -}}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </details>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  </header-disclosure-navigation>
{% endif %}

{% stylesheet %}
  .header-utility-navigation,
  .header-utility-navigation nav,
  .header-utility-navigation__list,
  .header-utility-navigation__item,
  .header-utility-navigation__details {
    height: 100%;
  }

  .header-utility-navigation__list {
    display: flex;
    align-items: stretch;
    margin: 0;
    padding: 0;
  }

  .header-utility-navigation__item {
    position: relative;
    flex: 0 0 auto;
  }

  .header-utility-navigation__link {
    display: inline-flex;
    height: 100%;
    min-height: 44px;
    align-items: center;
    gap: 5px;
    padding-inline: clamp(8px, 1vw, 14px);
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 450;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
    transition: color var(--animation-speed-fast) ease, background-color var(--animation-speed-fast) ease;
  }

  .header-utility-navigation__link::-webkit-details-marker {
    display: none;
  }

  .header-utility-navigation__link:hover,
  .header-utility-navigation__link:focus-visible,
  .header-utility-navigation__link--active,
  .header-utility-navigation__details[open] > .header-utility-navigation__link {
    background: rgb(var(--color-foreground-rgb) / 0.06);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .header-utility-navigation__caret {
    width: 9px;
    height: 9px;
    transition: transform var(--animation-speed-fast) ease;
  }

  .header-utility-navigation__details[open] > .header-utility-navigation__link .header-utility-navigation__caret {
    transform: rotate(180deg);
  }

  .header-utility-navigation__dropdown {
    position: absolute;
    top: calc(100% - 2px);
    left: 50%;
    z-index: var(--layer-heightened);
    display: block;
    width: max-content;
    min-width: 220px;
    max-width: 320px;
    padding: 8px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 12px;
    background: var(--color-background);
    box-shadow: 0 14px 34px rgb(var(--color-shadow-rgb, 0 0 0) / 0.14);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity var(--animation-speed-fast) ease, transform var(--animation-speed-fast) ease,
      visibility var(--animation-speed-fast) ease;
  }

  .header-utility-navigation__details:not([open]) > .header-utility-navigation__dropdown {
    display: block;
  }

  .header-utility-navigation__details[open] > .header-utility-navigation__dropdown,
  .header-utility-navigation__details:hover > .header-utility-navigation__dropdown,
  .header-utility-navigation__details:focus-within > .header-utility-navigation__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .header-utility-navigation__item:last-child .header-utility-navigation__dropdown {
    right: 0;
    left: auto;
    transform: translateY(8px);
  }

  .header-utility-navigation__item:last-child .header-utility-navigation__details[open] > .header-utility-navigation__dropdown,
  .header-utility-navigation__item:last-child .header-utility-navigation__details:hover > .header-utility-navigation__dropdown,
  .header-utility-navigation__item:last-child .header-utility-navigation__details:focus-within > .header-utility-navigation__dropdown {
    transform: translateY(0);
  }

  .header-utility-navigation__dropdown-list,
  .header-utility-navigation__nested-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .header-utility-navigation__nested-list {
    margin-block: 2px 6px;
    padding-inline-start: 12px;
  }

  .header-utility-navigation__dropdown-link,
  .header-utility-navigation__nested-link {
    display: block;
    padding: 9px 11px;
    border-radius: 8px;
    color: var(--color-foreground);
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .header-utility-navigation__nested-link {
    padding-block: 7px;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    font-size: 0.8125rem;
  }

  .header-utility-navigation__dropdown-link:hover,
  .header-utility-navigation__dropdown-link:focus-visible,
  .header-utility-navigation__nested-link:hover,
  .header-utility-navigation__nested-link:focus-visible {
    background: rgb(var(--color-foreground-rgb) / 0.06);
    color: var(--color-foreground);
    text-decoration: none;
  }

  #header-component[data-menu-style='drawer'] .header-utility-navigation {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .header-utility-navigation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-utility-navigation__dropdown,
    .header-utility-navigation__caret,
    .header-utility-navigation__link {
      transition: none;
    }
  }
{% endstylesheet %}
